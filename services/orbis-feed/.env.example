# Providers: synthetic, csv, yahoo, binance ou mt5.
ORBIS_FEED_PROVIDER=synthetic
ORBIS_FEED_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
ORBIS_FEED_TIMEFRAMES=M1,M5,M15,H1
ORBIS_FEED_HOME=.
ORBIS_FEED_POLL_SECONDS=5
ORBIS_FEED_BOOTSTRAP_BARS=2000
ORBIS_FEED_OVERLAP_BARS=5
ORBIS_FEED_MAX_BATCH_BARS=100000
ORBIS_FEED_CLOSE_GRACE_SECONDS=2
ORBIS_FEED_REQUEST_TIMEOUT_SECONDS=20

# CSV: data/imports/EURUSD_M5.csv, por exemplo.
# ORBIS_CSV_DIRECTORY=./data/imports
# ORBIS_CSV_PATTERN={symbol}_{timeframe}.csv

# Binance pública, sem chave. Símbolos como BTCUSDT, ETHUSDT.
# ORBIS_BINANCE_BASE_URL=https://api.binance.com

# Yahoo Finance: ações, ETFs, índices, câmbio e cripto conforme ticker do Yahoo.
# Exemplos: PETR4.SA, ^BVSP, EURUSD=X, BTC-USD
# ORBIS_YAHOO_AUTO_ADJUST=false

# MetaTrader 5 — opcionais quando a conta já está salva no terminal.
# ORBIS_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# ORBIS_MT5_LOGIN=12345678
# ORBIS_MT5_PASSWORD=
# ORBIS_MT5_SERVER=Nome-Da-Corretora
# ORBIS_MT5_TIMEOUT_MS=60000
# ORBIS_MT5_PORTABLE=false
