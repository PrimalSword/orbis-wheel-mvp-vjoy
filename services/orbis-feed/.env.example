# Use synthetic no primeiro teste; troque para mt5 quando o banco estiver validado.
ORBIS_FEED_PROVIDER=synthetic
ORBIS_FEED_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
ORBIS_FEED_TIMEFRAMES=M1,M5,M15,H1
ORBIS_FEED_HOME=.
ORBIS_FEED_POLL_SECONDS=5
ORBIS_FEED_BOOTSTRAP_BARS=2000
ORBIS_FEED_OVERLAP_BARS=5
ORBIS_FEED_MAX_BATCH_BARS=100000
ORBIS_FEED_CLOSE_GRACE_SECONDS=2

# MetaTrader 5 — todos opcionais quando a conta já está salva no terminal.
# ORBIS_MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# ORBIS_MT5_LOGIN=12345678
# ORBIS_MT5_PASSWORD=
# ORBIS_MT5_SERVER=Nome-Da-Corretora
# ORBIS_MT5_TIMEOUT_MS=60000
# ORBIS_MT5_PORTABLE=false
